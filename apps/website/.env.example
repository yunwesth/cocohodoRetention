# Local development. Set both URLs to real HTTPS origins for a hosted deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_REWARDS_URL=http://localhost:3000
# Keep false until services, rules, privacy, and physical-device checks are complete.
NEXT_PUBLIC_REWARDS_LIVE=false
# Opt-in to indexing only after the public launch review.
WEBSITE_PUBLIC_LAUNCH=false
