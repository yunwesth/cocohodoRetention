{
  "name": "cocohodo-rewards",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "playwright test",
    "test:flows": "playwright test --config playwright.live.config.ts",
    "dev:website": "next dev website --webpack --port 3001 --hostname 127.0.0.1",
    "build:website": "next build website --webpack",
    "start:website": "next start website --port 3001 --hostname 127.0.0.1",
    "typecheck:website": "tsc --project website/tsconfig.json --noEmit",
    "test:website": "playwright test --config playwright.website.config.ts",
    "dev:all": "node scripts/dev-all.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@zxing/browser": "^0.2.1",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module"
}
