{
  "name": "cocohodo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --workspace @cocohodo/rewards",
    "build": "npm run build --workspace @cocohodo/rewards",
    "start": "npm run start --workspace @cocohodo/rewards --",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "playwright test",
    "test:flows": "playwright test --config playwright.live.config.ts",
    "dev:website": "npm run dev --workspace @cocohodo/website",
    "build:website": "npm run build --workspace @cocohodo/website",
    "start:website": "npm run start --workspace @cocohodo/website --",
    "typecheck:website": "npm run typecheck --workspace @cocohodo/website",
    "test:website": "playwright test --config playwright.website.config.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "env:setup": "node scripts/setup-env.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
